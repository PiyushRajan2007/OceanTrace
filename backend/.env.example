# AQUAVIGIL Intelligence API Configuration
# Copy to .env and update with your values

# Application mode
APP_MODE=DEMO

# Database connection (optional for DEMO mode)
DATABASE_URL=postgresql+psycopg://aquavigil:aquavigil@localhost:5432/aquavigil

# CORS origins (comma-separated)
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# API configuration
API_V1_PREFIX=/api/v1
